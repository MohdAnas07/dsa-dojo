# URL of your Piston code-execution server (needed for Python, Java, C++, C, Go, TypeScript).
# JavaScript works without it. Leave empty to disable server languages.
PISTON_URL=
# Optional: Authorization header value if your Piston server requires one.
PISTON_TOKEN=
# Optional tuning
RUN_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=30

# ---- Accounts (optional): Google sign-in + progress saved to a database ----
# All four of DATABASE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and NEXTAUTH_SECRET are needed.
# Leave them empty and the site runs without accounts (progress stays in the browser).
# Setup steps: README → "Accounts: Google sign-in and saved progress".

# Postgres connection string (for example Neon's pooled URL). Tables are created automatically.
DATABASE_URL=
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string used to sign session cookies. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The exact address of your site. Locally: http://localhost:3000
NEXTAUTH_URL=
# Optional tuning
SAVES_PER_MINUTE=60
DATABASE_POOL_MAX=5
# Optional: shown on the /privacy page as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

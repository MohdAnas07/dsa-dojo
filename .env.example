# URL of your Piston code-execution server (needed for Python, Java, C++, C, Go, TypeScript).
# JavaScript works without it. Leave empty to disable server languages.
PISTON_URL=
# Optional: Authorization header value if your Piston server requires one.
PISTON_TOKEN=
# Optional tuning
RUN_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=30

{
  "name": "dsa-dojo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "tsx scripts/generate-expected.ts && tsx scripts/generate-traces.ts",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "npm run generate && tsx scripts/verify/starters.ts && tsx scripts/verify/python-samples.ts && tsx scripts/verify/statements.ts --strict && npm run verify:viz && tsx scripts/generate-traces.ts --strict && npm run verify:traces",
    "verify:backend": "node scripts/verify/backend.mjs",
    "piston:setup": "npm run piston:up && npm run piston:install",
    "piston:up": "docker compose -f docker-compose.piston.yml up -d",
    "piston:install": "node scripts/piston-install.mjs http://localhost:2000",
    "piston:down": "docker compose -f docker-compose.piston.yml down",
    "piston:logs": "docker compose -f docker-compose.piston.yml logs -f piston",
    "dev:executor": "node scripts/dev-executor.mjs",
    "verify:viz": "tsx --tsconfig scripts/verify/tsconfig.json scripts/verify/viz.ts",
    "verify:traces": "tsx --tsconfig scripts/verify/tsconfig.json scripts/verify/traces.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
